# ============================================================================
# MangataAgent 环境变量配置模板
# 复制此文件为 .env 并填入你的实际配置
# ============================================================================

# LLM 模型配置 (支持 DashScope / OpenAI / Compatible 接口)
LLM_MODEL_ID=qwen-plus
LLM_API_KEY=sk-your-llm-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=60

# Redis 会话与分布式锁配置 (生产环境必需)
# 本地裸机部署示例: redis://127.0.0.1:6379/0
# Docker-Compose 部署示例: redis://redis:6379/0
CHAT_REDIS_URL=redis://127.0.0.1:6379/0
CHAT_LOCK_TTL_MS=30000
CHAT_RESULT_TTL_SECONDS=86400

# A2A (Agent-to-Agent) 服务间内部通信安全令牌 (生产环境请务必修改为强随机字符串)
A2A_SERVICE_TOKEN=mangata-secret-token-change-in-production
A2A_HOST=0.0.0.0
A2A_PORT=8000

# 外部工具与搜索配置 (可选)
TAVILY_API_KEY=
SERPAPI_API_KEY=

# 向量数据库 Qdrant 配置 (可选，用于本地长记忆与 RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# 图数据库 Neo4j 配置 (可选，用于知识图谱)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# TypeSafe Jev 决策层配置 (可选)
TYPESAFE_API_KEY=
JEV_ENABLED=false
