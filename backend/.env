# ============================================================================
# HelloAgents 统一环境变量配置文件
# ============================================================================
# 复制此文件为 .env 并填入你的API密钥
# 系统要求：Python 3.10+ （必需）

# ============================================================================
# 🚀 统一配置格式（推荐）- 框架自动检测provider
# ============================================================================
# 只需配置以下4个通用环境变量，框架会自动识别LLM提供商：

# .env file
MODELSCOPE_API_KEY=sk-29f95fb8e6304b5db9c6553782415b06


# 模型名称
LLM_MODEL_ID=qwen-plus
# API密钥
LLM_API_KEY=sk-ws-H.RPYIHHM.qf0W.MEUCIQC4sZlucQXeN0M2XgvZXorncEBjjvu1AKldFODG8qAxBAIgSwMlHxdgpUR8HZi-vHlCitra6SezKbPnj-Kt1IMoXsI
# 服务地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60


# ============================================================================
# 🛠️ 工具配置（可选）
# ============================================================================

# Tavily搜索（推荐）- 获取API密钥：https://tavily.com/
TAVILY_API_KEY=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

# SerpApi搜索（备选）- 获取API密钥：https://serpapi.com/
SERPAPI_API_KEY=6a4a8fe3adce63cfd41944c33c63269c93bca32d6286a8e684a88024143d3e8e

# ================================
# Qdrant 向量数据库配置 - 获取API密钥：https://cloud.qdrant.io/
# ================================
# 使用Qdrant云服务 (推荐)
# QDRANT_URL=https://0dc711a4-592a-4808-ab0b-5321b78f936c.sa-east-1-0.aws.cloud.qdrant.io
# QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6NTM1NmU3YzAtMTNlMS00YzQ3LTlmMmEtMmNmYmY0NmJmZDMwIn0.ZLLeYvzclROx5ZAoUYXAWd_69X0-JUa5LsbQobTSXjI

# # 或使用本地Qdrant (需要Docker)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=hello-agents-key
#
# Qdrant集合配置
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ================================
# Neo4j 图数据库配置 - 获取API密钥：https://neo4j.com/cloud/aura/
# ================================
# 使用Neo4j Aura云服务 (推荐)
# NEO4J_URI=neo4j+s://b4cf835b.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=LNXWYVDdYKMlxdNhhsMlZR1Nasv1DU9YxpMimfmTUUQ

# 或使用本地Neo4j (需要Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=12345

# Neo4j连接配置
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ==========================
# 嵌入（Embedding）配置示例 - 可从阿里云控制台获取：https://dashscope.aliyun.com/
# ==========================
# - 若为空，dashscope 默认 text-embedding-v3；local 默认 sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=sk-ws-H.RPYIHHM.qf0W.MEUCIQC4sZlucQXeN0M2XgvZXorncEBjjvu1AKldFODG8qAxBAIgSwMlHxdgpUR8HZi-vHlCitra6SezKbPnj-Kt1IMoXsI
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

