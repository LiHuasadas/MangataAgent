FROM python:3.11-slim

WORKDIR /app

# 替换为阿里云镜像源，解决国内服务器访问 deb.debian.org 极慢的问题
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list 2>/dev/null || true

# 安装必要的系统构建库与工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# 拷贝官方预编译的 uv / uvx 高性能二进制工具
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 先复制依赖文件并利用 Docker 缓存层
COPY backend/requirements-api.txt backend/requirements-api.txt
COPY backend/requirements-agents.txt backend/requirements-agents.txt

# 使用 uv 进行极速系统级依赖安装（配置阿里云 PyPI 镜像源，数秒完成）
RUN uv pip install --system --no-cache -i https://mirrors.aliyun.com/pypi/simple/ -r backend/requirements-agents.txt

# 拷贝项目全量代码
COPY . /app

# 确保运行时目录存在
RUN mkdir -p /app/project /app/kb /app/memory_data

ENV PYTHONUNBUFFERED=1
ENV PYTHONIOENCODING=utf-8
ENV A2A_HOST=0.0.0.0

# 暴露 Host Agent 网关(8000)及各专长智能体端口(8001-8004)
EXPOSE 8000 8001 8002 8003 8004

# 一键启动所有智能体集群
CMD ["python", "main.py", "--agent", "all", "--host", "0.0.0.0"]
